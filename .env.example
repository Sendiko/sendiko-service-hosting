# Port exposed on the host machine.
APP_PORT=3000
DATABASE_URL=postgresql://sendiko:sendiko-local-password@localhost:5432/sendiko?schema=public
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-secret

# Staging container configuration (optional overrides)
STG_APP_PORT=3001
STG_DATABASE_URL=postgresql://sendiko:sendiko-local-password@localhost:5432/sendiko?schema=staging
# STG_ADMIN_USERNAME=admin
# STG_ADMIN_PASSWORD=change-this-password
# STG_AUTH_SECRET=replace-with-a-long-random-secret
